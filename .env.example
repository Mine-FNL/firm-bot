# firm-bot environment configuration.
# Copy to .env and adjust as needed; .env is gitignored.

# Where all firm state lives. Created on first run.
FIRM_BOT_DATA_DIR=./data

# Local Ollama endpoint. Default works for a stock Ollama install.
FIRM_BOT_OLLAMA_HOST=http://127.0.0.1:11434

# Models used by default. Override per-firm via the firm's config.yaml.
FIRM_BOT_LLM_MODEL=qwen2.5-coder:14b
FIRM_BOT_LLM_JUDGE_MODEL=qwen2.5-coder:7b

# Embedding model. Override only at first ingest (changing it later
# requires rebuilding the vector store).
FIRM_BOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OCR tuning — raise FIRM_BOT_OCR_PAGES for firms with long scanned
# contracts; lower it if OCR cost is a concern.
FIRM_BOT_OCR_PAGES=25